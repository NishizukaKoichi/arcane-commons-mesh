{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcane-commons-mesh-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcane-commons-mesh-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "env": {
    "production": {
      "name": "arcane-commons-mesh-api-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arcane-commons-mesh-production",
          "database_id": "CLOUDFLARE_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["0 */6 * * *"]
      }
    }
  }
}
