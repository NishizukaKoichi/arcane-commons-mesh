{
  "name": "arcane-commons-mesh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "cargo run -p arcane-mesh-cli -- doctor",
    "lint": "pnpm --filter @arcane-commons/api lint && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "format:check": "cargo fmt --all -- --check",
    "typecheck": "pnpm --filter @arcane-commons/api typecheck && cargo check --workspace --all-features",
    "test": "pnpm --filter @arcane-commons/api test && cargo test --workspace --all-features",
    "test:integration": "cargo run -p arcane-mesh-cli -- verify-mvp",
    "build": "pnpm --filter @arcane-commons/api build && cargo build --workspace --all-features",
    "demo:up": "cargo run -p arcane-mesh-cli -- demo up",
    "demo:down": "cargo run -p arcane-mesh-cli -- demo down",
    "verify:mvp": "cargo run -p arcane-mesh-cli -- verify-mvp"
  }
}
